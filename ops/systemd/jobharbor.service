[Unit]
Description=JobHarbor Docker Compose Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/jobharbor
Environment=JOBHARBOR_HOME=/opt/jobharbor/workspace
Environment=JOBHARBOR_PROFILE_PATH=/opt/jobharbor/workspace/config/profile.yml
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
